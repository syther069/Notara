{
  "name": "notara",
  "version": "0.1.0",
  "private": true,
  "description": "Payment links people can trust and on-chain enforced spending for AI agents, built on NEAR",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/syther069/Notara.git"
  },
  "homepage": "https://notara-sable.vercel.app",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "passport": "tsx passport/src/cli.ts",
    "check": "tsx passport/src/cli.ts check",
    "serve": "tsx server/index.ts",
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "owner": "tsx scripts/owner.ts",
    "agent": "tsx agent/src/run.ts",
    "demo": "tsx agent/src/demo.ts",
    "test": "tsx --test passport/test/*.test.ts agent/test/*.test.ts server/test/*.test.ts web/src/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:contracts": "cargo test",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "attest": "tsx scripts/attest.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "borsh": "2.0.0",
    "near-api-js": "7.4.0",
    "near-sign-verify": "0.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
