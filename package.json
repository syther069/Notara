{
  "name": "notara",
  "version": "0.1.0",
  "private": true,
  "description": "Counterparty verification and payment enforcement for autonomous AI agents on NEAR",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "passport": "tsx passport/src/cli.ts",
    "check": "tsx passport/src/cli.ts check",
    "serve": "tsx server/index.ts",
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "owner": "tsx scripts/owner.ts",
    "agent": "tsx agent/src/run.ts",
    "demo": "tsx agent/src/demo.ts",
    "test": "tsx --test passport/test/*.test.ts agent/test/*.test.ts server/test/*.test.ts web/src/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:contracts": "cargo test",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "borsh": "2.0.0",
    "near-api-js": "7.4.0",
    "near-sign-verify": "0.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
